FRONTEND_URL=""            # deployed frontend origin, e.g. https://sachai.vercel.app
DATABASE_URL=""            # Neon Postgres connection string
HF_SPACE=""                # detector Space, e.g. your-username/sachai-model-service
HF_TOKEN=""                # HF token (ZeroGPU quota is charged to this account)
GROQ_API_KEY=""            # enables the Groq models (GPT-OSS, Qwen)
OPEN_ROUTER_API_KEY=""     # enables the OpenRouter models (Llama, Gemini, Claude, DeepSeek, GPT-4o mini)
TYPESAFE_API_KEY=""        # Jev: fast reranking + verification (~0.3 s); without it the slower HF detector is used
MAX_RETRIES=3
